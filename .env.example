# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Live demo data (/api/demo). A fine-grained token with no extra permissions is enough; without
# it GitHub allows 60 requests an hour and the Contribution Graph demo falls back to sample data.
GITHUB_TOKEN=

# Now Playing reads whichever music service is set; leave both empty for sample data.
# Spotify: an app's client id and secret, and a refresh token with the
# user-read-currently-playing and user-read-recently-played scopes.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Last.fm: an API key from last.fm/api and your username.
LASTFM_API_KEY=
LASTFM_USER=
